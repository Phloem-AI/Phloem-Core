{
  "name": "phloem",
  "version": "0.1.1",
  "description": "A stdio MCP server that gives coding agents measured Playwright browser tools",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.17"
  },
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "postinstall": "playwright install chromium"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phloem-AI/Phloem-Core.git"
  },
  "keywords": [
    "mcp",
    "playwright",
    "browser-testing"
  ],
  "author": "Qasim-Hassan",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axe-core": "^4.14.0",
    "playwright": "^1.64.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "bugs": {
    "url": "https://github.com/Phloem-AI/Phloem-Core/issues"
  },
  "homepage": "https://github.com/Phloem-AI/Phloem-Core#readme"
}
